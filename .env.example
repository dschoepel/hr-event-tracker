# Copy to .env.local for development. Production values are set in Dockhand's
# Environment Variables panel (see ARCHITECTURE.md → Deployment).

# --- Required ---
SESSION_SECRET=                  # signs owner + viewer cookies: openssl rand -base64 32
OWNER_PASSWORD_HASH=             # node scripts/hash-password.js '<your password>'

# --- Optional ---
# DB_PATH=./data/hr_events.db    # SQLite file (default shown)
# GPX_PATH=./data/gpx            # raw GPX storage (default: <DB_PATH dir>/gpx)
# PUPPETEER_EXECUTABLE_PATH=     # Chrome/Chromium for PDF download (auto-detected if unset)
